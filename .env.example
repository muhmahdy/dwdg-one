# Public browser configuration for shared mode. The publishable key is not a secret.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Set the first Super Admin email through a private SQL setting as described
# in supabase/README.md. Never use a service-role key in a VITE_ variable.
