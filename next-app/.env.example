# Copy this file to .env.local and fill in the values from your Supabase project (Settings -> API).
# .env.local is ignored by git. Never commit real values.

# Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Full access to the database, ignores row level security.
# Used only by supabase/tools/move-data.mjs on your own machine. Never give it a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Local development only: show the demo sign-in (pick a person) instead of Google sign-in. Keep false in production.
NEXT_PUBLIC_DEMO_PERSONAS=false
