{
  "name": "@dwdg/server",
  "version": "1.0.0-migration",
  "private": true,
  "type": "module",
  "description": "The server in front of the hub and the division Supabase projects (migration plan stage H2).",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local src/dev.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.0",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@supabase/supabase-js": "2.117.2",
    "hono": "4.13.13",
    "zod": "4.6.5"
  }
}
