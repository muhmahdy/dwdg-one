# Server configuration (never prefix with VITE_, never commit real values). Copy to server/.env.local for development.
# The hub is required; a division project is used only when BOTH of its variables are set and the hub marks it active.
HUB_SUPABASE_URL=https://YOUR_HUB_PROJECT.supabase.co
# The publishable (anon) key of the hub: used to check a person's token and to act as that person. Safe by design.
HUB_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server only. Writes audit_log and pings the hub. Skips row level security.
HUB_SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# Division projects (leave empty for the ones not created yet): SPOKE_<DIVISION>_URL / SPOKE_<DIVISION>_SERVICE_KEY
SPOKE_EE_URL=
SPOKE_EE_SERVICE_KEY=
SPOKE_MCIT_URL=
SPOKE_MCIT_SERVICE_KEY=
SPOKE_HR_URL=
SPOKE_HR_SERVICE_KEY=
SPOKE_FNL_URL=
SPOKE_FNL_SERVICE_KEY=
SPOKE_SNG_URL=
SPOKE_SNG_SERVICE_KEY=
SPOKE_CONS_URL=
SPOKE_CONS_SERVICE_KEY=

# Shared secret of the scheduled job (GET /api/cron/ping with `Authorization: Bearer <secret>`). Without it the job is switched off.
# 32 random bytes are plenty: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# The header in which the host in front of the server puts the visitor's address (x-forwarded-for, fly-client-ip, cf-connecting-ip).
# Use one the host overwrites. Only the brake on refused tokens reads it.
CLIENT_IP_HEADER=x-forwarded-for

# Port (hosts usually set it themselves) and address to listen on (production default 0.0.0.0)
PORT=8787
# Only when the browser calls the server from another origin; leave empty when /api is proxied or rewritten (same origin).
CORS_ORIGIN=
