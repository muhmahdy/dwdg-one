# Browser configuration. These values end up in the public bundle; the publishable key is safe there by design.
# Never put a service-role key or a database password in a VITE_ variable.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Where records come from: `supabase` (default, the browser asks Supabase directly), `bff` (through the server in ../server,
# the hub-and-spoke layout) or `demo`. Sign-in always uses Supabase. The server holds all other keys; none belongs here.
VITE_DATA_MODE=supabase
# Origin of the server in `bff` mode. Leave empty to use the same origin (/api, proxied by `npm run dev`).
VITE_API_URL=

# Development only: in-memory demo workspace and persona picker (decision M9). Use `npm run dev:demo` instead of setting it here.
VITE_DEMO_MODE=false
