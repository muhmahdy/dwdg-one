# Operator-only settings for scripts/ (backup, restore, data move). Copy to scripts/.env.local; never commit real values.
# Never put these in frontend/.env* and never prefix them with VITE_.

# Postgres connection strings for backups, one per project (Supabase → Project Settings → Database). The hub is
# DATABASE_URL_HUB (the old single DATABASE_URL still works for the hub). Leave out the projects you do not back up yet.
DATABASE_URL_HUB=postgresql://postgres.YOUR_HUB:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL_EE=
DATABASE_URL_MCIT=
DATABASE_URL_HR=
DATABASE_URL_FNL=
DATABASE_URL_SNG=
DATABASE_URL_CONS=

# Encrypts backups at rest. Required for HR and Finance & Legal, which are never written without it. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it in the shared password manager, apart from the backups: a backup cannot be restored without it.
BACKUP_ENCRYPTION_KEY=

# Scratch database for restore drills and rls_smoke.sql. Must not be a production database.
SCRATCH_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Data move (scripts/database/move-data.mjs --target ...): the address and the SERVICE key of each project, one pair per project.
# These keys skip row level security: this file stays on the operator's machine. Two projects with the same address are refused.
# The hub (and `--target legacy`, the single database of today) also answer to the old SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_URL_HUB=https://YOUR_HUB.supabase.co
SUPABASE_SERVICE_KEY_HUB=YOUR_HUB_SERVICE_KEY
SUPABASE_URL_EE=
SUPABASE_SERVICE_KEY_EE=
SUPABASE_URL_MCIT=
SUPABASE_SERVICE_KEY_MCIT=
SUPABASE_URL_HR=
SUPABASE_SERVICE_KEY_HR=
SUPABASE_URL_FNL=
SUPABASE_SERVICE_KEY_FNL=
SUPABASE_URL_SNG=
SUPABASE_SERVICE_KEY_SNG=
SUPABASE_URL_CONS=
SUPABASE_SERVICE_KEY_CONS=
