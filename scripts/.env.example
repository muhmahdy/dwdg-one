# Operator-only settings for scripts/ (backup, restore, data move). Copy to scripts/.env.local; never commit real values.
# Never put these in frontend/.env* and never prefix them with VITE_.

# Postgres connection string for backups (Supabase → Project Settings → Database).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Scratch database for restore drills and rls_smoke.sql. Must not be the production database.
SCRATCH_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Data move (scripts/database/move-data.mjs --apply).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
